    given-names: Yewon
    affiliation: "Yonsei University"
repository-code: "https://github.com/yeong22/Endoscopic-Radiomics-for-Bladder-Cancer-Grading"
url: "https://doi.org/10.1016/j.euros.2026.03.018"
license: Apache-2.0
keywords:
  - endoscopic radiomics
  - endoscopy image analysis
  - cystoscopy
  - white-light cystoscopy
  - bladder cancer
  - urothelial carcinoma
  - tumour grade prediction
  - radiomics
  - image feature quantification
  - texture analysis
  - PyRadiomics
  - explainable AI
  - SHAP
  - medical image analysis
